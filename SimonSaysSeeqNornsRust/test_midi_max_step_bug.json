{
  "name": "MIDI Max Step Bug Test",
  "description": "Tests MIDI output for row with max_step=15 to verify it triggers every 16 steps, not every 32 steps",
  "bpm": 30.0,
  "comments": [
    "This test specifically checks for the 'MIDI silent half the time' bug",
    "Row 3 has max_step=15 (16-step cycle) with a note programmed on step 0",
    "Expected: MIDI note 51 should trigger at master steps 0, 16, 32, 48, 64",
    "Bug symptom: MIDI note 51 only triggers at master steps 0, 32, 64 (every 32 steps instead of 16)",
    "",
    "The row should play its 16-step pattern twice per 32 master steps",
    "If it only plays once per 32 master steps, that's the 'half the time' bug"
  ],
  "commands": [
    {
      "at_tick": 0,
      "action": {
        "type": "LogMessage",
        "message": "🧪 MIDI Max Step Bug Test - Row 3 (max_step=15, note on step 0)"
      }
    },
    {
      "at_tick": 3,
      "action": {
        "type": "LogMessage",
        "message": "📍 Master Step 0: Row 3 at step 0 - Expecting MIDI note 51"
      }
    },
    {
      "at_tick": 3,
      "action": {
        "type": "VerifyState",
        "step": 0,
        "row": 3,
        "expected": 0
      }
    },
    {
      "at_tick": 3,
      "action": {
        "type": "VerifyMidiNote",
        "step": 0,
        "note": 51,
        "velocity": null,
        "channel": 1,
        "event_type": "NoteOn"
      }
    },
    {
      "at_tick": 99,
      "action": {
        "type": "LogMessage",
        "message": "📍 Master Step 16: Row 3 should wrap to step 0 - Expecting MIDI note 51"
