{
  "name": "Test2: Single Row Max Step Change",
  "description": "Test changing Row 0 max_step from 31 to 7 at step 3, verify at steps 4, 5, 6",
  "initial_bpm": 30.0,
  "commands": [
    {
      "command": "LogMilestone",
      "message": "Starting Test2: 6 steps total, change at step 3"
    },
    {
      "command": "Stop"
    },
    {
      "command": "Wait",
      "ms": 500
    },
    {
      "command": "LoadPattern",
      "file": "test_pattern_1.json"
    },
    {
      "command": "ReloadPattern"
    },
    {
      "command": "Wait",
      "ms": 200
    },
    {
      "command": "LogMilestone",
      "message": "Starting sequencer - Row 0 initial max_step=31"
    },
    {
      "command": "Start"
    },
    {
      "command": "Wait",
      "ms": 500
    },
    {
      "command": "LogMilestone",
      "message": "Running 3 steps with initial configuration"
    },
    {
      "command": "WaitSteps",
      "count": 3
    },
    {
      "command": "LogMilestone",
      "message": "At step 3: Sending SysEx to change Row 0 max_step to 7"
    },
    {
      "command": "SysExButton",
      "row": 7,
      "col": 8,
      "press": true
    },
    {
      "command": "Wait",
      "ms": 50
    },
    {
      "command": "SysExButton",
      "row": 0,
      "col": 7,
      "press": true
    },
    {
      "command": "Wait",
      "ms": 50
    },
    {
      "command": "SysExButton",
      "row": 0,
      "col": 7,
      "press": false
    },
    {
      "command": "Wait",
      "ms": 50
    },
    {
      "command": "SysExButton",
      "row": 7,
      "col": 8,
      "press": false
    },
    {
      "command": "RecordRowConfig",
      "row": 0,
      "max_step": 7
    },
    {
      "command": "LogMilestone",
      "message": "Advancing to step 4 - should take effect now"
    },
    {
      "command": "WaitSteps",
      "count": 1
    },
    {
      "command": "VerifyState",
      "description": "Check sequencer state at cumulative step 4"
    },
    {
      "command": "LogMilestone",
      "message": "Advancing to step 5"
    },
    {
      "command": "WaitSteps",
      "count": 1
    },
    {
      "command": "VerifyState",
      "description": "Check sequencer state at cumulative step 5"
    },
    {
      "command": "LogMilestone",
      "message": "Advancing to step 6"
    },
    {
      "command": "WaitSteps",
      "count": 1
    },
    {
      "command": "VerifyState",
      "description": "Check sequencer state at cumulative step 6"
    },
    {
      "command": "LogMilestone",
      "message": "Test complete"
    },
    {
      "command": "Stop"
    }
  ]
}