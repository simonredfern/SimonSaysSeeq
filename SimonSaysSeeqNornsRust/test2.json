{
  "name": "Test2 Direct: Single Row Max Step Change",
  "description": "Tick-synchronized test of changing Row 0 max_step from 31 to 7 at step 3",
  "bpm": 30.0,
  "commands": [
    {
      "at_tick": 0,
      "action": {
        "type": "LogMessage",
        "message": "Starting Test2: Row 0 max_step change from 31 to 7 at step 3"
      }
    },
    {
      "at_tick": 6,
      "action": {
        "type": "VerifyState",
        "step": 1,
        "row": 0,
        "expected": 1
      }
    },
    {
      "at_tick": 12,
      "action": {
        "type": "VerifyState",
        "step": 2,
        "row": 0,
        "expected": 2
      }
    },
    {
      "at_tick": 18,
      "action": {
        "type": "LogMessage",
        "message": "Step 3 reached - sending SysEx to change Row 0 max_step to 7"
      }
    },
    {
      "at_tick": 18,
      "action": {
        "type": "SysExButton",
        "row": 7,
        "col": 8,
        "press": true
      }
    },
    {
      "at_tick": 18,
      "action": {
        "type": "SysExButton",
        "row": 0,
        "col": 7,
        "press": true
      }
    },
    {
      "at_tick": 18,
      "action": {
        "type": "SysExButton",
        "row": 0,
        "col": 7,
        "press": false
      }
    },
    {
      "at_tick": 18,
      "action": {
        "type": "SysExButton",
        "row": 7,
        "col": 8,
        "press": false
      }
    },
    {
      "at_tick": 24,
      "action": {
        "type": "LogMessage",
        "message": "Step 4 - verifying if max_step change has taken effect"
      }
    },
    {
      "at_tick": 24,
      "action": {
        "type": "VerifyState",
        "step": 4,
        "row": 0,
        "expected": 3
      }
    },
    {
      "at_tick": 30,
      "action": {
        "type": "LogMessage",
        "message": "Step 5 - continued verification"
      }
    },
    {
      "at_tick": 30,
      "action": {
        "type": "VerifyState",
        "step": 5,
        "row": 0,
        "expected": 4
      }
    },
    {
      "at_tick": 36,
      "action": {
        "type": "LogMessage",
        "message": "Step 6 - continued verification"
      }
    },
    {
      "at_tick": 36,
      "action": {
        "type": "VerifyState",
        "step": 6,
        "row": 0,
        "expected": 5
      }
    },
    {
      "at_tick": 42,
      "action": {
        "type": "LogMessage",
        "message": "Step 7 - continued verification"
      }
    },
    {
      "at_tick": 42,
      "action": {
        "type": "VerifyState",
        "step": 7,
        "row": 0,
        "expected": 6
      }
    },
    {
      "at_tick": 48,
      "action": {
        "type": "LogMessage",
        "message": "Step 8 - Row 0 should wrap to 0 (max_step=7)"
      }
    },
    {
      "at_tick": 48,
      "action": {
        "type": "VerifyState",
        "step": 8,
        "row": 0,
        "expected": 7
      }
    },
    {
      "at_tick": 54,
      "action": {
        "type": "LogMessage",
        "message": "Step 9 - Row 0 should have wrapped back to 0"
      }
    },
    {
      "at_tick": 54,
      "action": {
        "type": "VerifyState",
        "step": 9,
        "row": 0,
        "expected": 0
      }
    },
    {
      "at_tick": 60,
      "action": {
        "type": "LogMessage",
        "message": "Test complete - max_step change verified"
      }
    }
  ]
}